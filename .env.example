# ChainSIP 公共仓库示例环境变量
# 复制为 .env（或写入 systemd EnvironmentFile）后按实际环境修改。
# 所有值都只是占位符，生产环境必须替换为随机强口令。

# --- MySQL ---
CHAINSIP_DB_HOST=127.0.0.1
CHAINSIP_DB_PORT=3306
CHAINSIP_DB_NAME=chainsip
CHAINSIP_DB_USER=chainsip
CHAINSIP_DB_PASSWORD=change-me

# --- Redis（可选；不可用时自动降级）---
CHAINSIP_REDIS_HOST=127.0.0.1
CHAINSIP_REDIS_PORT=6379
CHAINSIP_REDIS_PASSWORD=
CHAINSIP_REDIS_DATABASE=1

# --- 安全密钥（生产必须替换，至少 32 字节）---
CHAINSIP_JWT_SECRET=change-me-in-production-jwt-secret-32bytes
CHAINSIP_CRYPTO_MASTER_KEY=change-me-in-production-master-key-32bytes

# --- 空库引导管理员（首次启动创建一次，登录后立即改密码）---
CHAINSIP_BOOTSTRAP_ADMIN_USERNAME=admin
CHAINSIP_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe_123456

# --- FISCO BCOS ---
CHAINSIP_SDK_CONFIG=./sdk/config.toml
CHAINSIP_GROUP_ID=1
CHAINSIP_CHAIN_ENDPOINT=127.0.0.1:20200
CHAINSIP_CORE_ADDRESS=
CHAINSIP_TRANSFER_ADDRESS=
# ADMIN 机构链账户私钥（64 位十六进制）。只通过环境变量或本地私有配置注入，绝不提交。
CHAINSIP_ADMIN_PRIVATE_KEY=

# --- 可选 ---
CHAINSIP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173
CHAINSIP_LOG_LEVEL=INFO