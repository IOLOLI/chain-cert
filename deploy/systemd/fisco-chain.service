[Unit]
Description=FISCO BCOS group1 chain (4 sealer + 1 observer/regulator)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=fisco
Group=fisco
WorkingDirectory=/opt/fisco/nodes/127.0.0.1
Environment=CHAIN_HOME=/opt/fisco/nodes/127.0.0.1
ExecStart=/opt/chainsip/deploy/chain-control.sh start
ExecStop=/opt/chainsip/deploy/chain-control.sh stop
RemainAfterExit=yes
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
