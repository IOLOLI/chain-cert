# 让 npm 在这个项目里更稳（IDEA 的 npm 工具窗口 / Terminal 都会读取它）
registry=https://registry.npmmirror.com

# 关键：npmmirror 对"尚未镜像命中"的包会回源同步，容易长时间无响应。
# 实测 axios / @element-plus/icons-vue 会 ETIMEDOUT 数次，因此把超时与重试调大。
fetch-timeout=600000
fetch-retries=6
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000

# 少做无用功
audit=false
fund=false

# 显示每一次 HTTP 请求（IDEA 里建议用 Terminal 跑，就能看到卡在哪个包）
loglevel=http
